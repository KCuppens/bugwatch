{
  "name": "bugwatch",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Error Tracking - Watch your bugs. Fix them faster.",
  "repository": {
    "type": "git",
    "url": "https://github.com/KCuppens/bugwatch.git"
  },
  "license": "FSL-1.1-Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/sdk/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.py": [
      "ruff check --fix",
      "ruff format"
    ],
    "*.rs": [
      "rustfmt"
    ],
    "*.go": [
      "gofmt -w"
    ],
    "*.java": [
      "google-java-format --replace"
    ],
    "*.rb": [
      "rubocop -A"
    ],
    "*.php": [
      "php-cs-fixer fix"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitest/coverage-v8": "^4.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3",
    "turbo": "^2.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.0.16"
  },
  "packageManager": "npm@10.8.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
