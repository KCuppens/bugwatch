{
  "name": "@bugwatch/mcp",
  "version": "0.2.0",
  "description": "MCP server for Bugwatch - AI-powered error tracking",
  "bin": {
    "bugwatch-mcp": "./dist/index.js",
    "bugwatch-mcp-http": "./dist/http.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start:http": "node dist/http.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "FSL-1.1-Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
