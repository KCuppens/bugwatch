{
  "name": "@bugwatch/react-native",
  "version": "0.4.3",
  "description": "Bugwatch SDK for React Native (bare and Expo)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "*.podspec",
    "expo-module.config.json",
    "react-native.config.js",
    "NATIVE.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bugwatch/core": "^0.4.2"
  },
  "devDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "@react-navigation/native": ">=6.0.0",
    "react": ">=17.0.0",
    "react-native": ">=0.70.0"
  },
  "peerDependenciesMeta": {
    "@react-navigation/native": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KCuppens/bugwatch.git",
    "directory": "packages/sdk/react-native"
  },
  "license": "FSL-1.1-Apache-2.0",
  "keywords": [
    "bugwatch",
    "error-tracking",
    "monitoring",
    "react-native",
    "expo",
    "sdk"
  ]
}
