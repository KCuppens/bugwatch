{
  "name": "@bugwatch/fastify",
  "version": "0.4.1",
  "description": "Bugwatch SDK integration for Fastify",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bugwatch/core": "^0.4.1",
    "fastify-plugin": "^4.5.1"
  },
  "peerDependencies": {
    "fastify": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "fastify": "^5.9.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KCuppens/bugwatch.git",
    "directory": "packages/sdk/fastify"
  },
  "license": "FSL-1.1-Apache-2.0",
  "keywords": [
    "bugwatch",
    "error-tracking",
    "fastify",
    "plugin",
    "monitoring"
  ]
}
