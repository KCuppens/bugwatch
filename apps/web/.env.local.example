# API URL for the backend server
NEXT_PUBLIC_API_URL=http://localhost:3000

# Deployment mode — controls whether the billing/upgrade UI is shown.
#   (unset) or "self-hosted" → billing UI hidden, all features unlocked
#   "saas"                   → billing UI visible, tier gating enforced
# Self-hosters should leave this unset.
NEXT_PUBLIC_DEPLOYMENT_MODE=

# Bugwatch SDK (self-monitoring)
NEXT_PUBLIC_BUGWATCH_API_KEY=your-api-key-here
