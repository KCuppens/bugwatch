# =============================================================================
# Server
# =============================================================================
SERVER_ADDR=0.0.0.0:3000

# =============================================================================
# Database (required)
# =============================================================================
DATABASE_URL=postgres://bugwatch:password@localhost:5432/bugwatch
# DATABASE_URL=sqlite:./data/bugwatch.db?mode=rwc  # SQLite for local dev
DATABASE_MAX_CONNECTIONS=50

# =============================================================================
# Security (required — use long random strings in production)
# =============================================================================
JWT_SECRET=CHANGE_ME_use_a_long_random_string_here
PASSWORD_RESET_SECRET=CHANGE_ME_use_a_different_long_random_string
OAUTH_STATE_SECRET=CHANGE_ME_use_a_third_long_random_string  # signs OAuth state params; falls back to JWT_SECRET if unset
BUGWATCH_ENCRYPTION_KEY=CHANGE_ME_32_bytes_hex_encoded_key  # for field-level encryption of integration tokens

# =============================================================================
# Application
# =============================================================================
BUGWATCH_MODE=self-hosted  # or "saas"
ENVIRONMENT=development    # development | staging | production
APP_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001  # comma-separated in production
TRUST_PROXY=false
COOKIE_SECURE=false  # set true when APP_URL starts with https

# =============================================================================
# SMTP (optional — required for password reset emails)
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@example.com

# =============================================================================
# Stripe API Keys (SaaS mode only — get from https://dashboard.stripe.com/apikeys)
# =============================================================================
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Price IDs (create in Stripe dashboard)
STRIPE_PRICE_ID_PRO_MONTHLY=price_YOUR_PRO_MONTHLY_ID
STRIPE_PRICE_ID_PRO_ANNUAL=price_YOUR_PRO_ANNUAL_ID
STRIPE_PRICE_ID_TEAM_MONTHLY=price_YOUR_TEAM_MONTHLY_ID
STRIPE_PRICE_ID_TEAM_ANNUAL=price_YOUR_TEAM_ANNUAL_ID

# =============================================================================
# OAuth Integrations (optional)
# =============================================================================
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
JIRA_CLIENT_ID=your_jira_client_id
JIRA_CLIENT_SECRET=your_jira_client_secret
LINEAR_CLIENT_ID=your_linear_client_id
LINEAR_CLIENT_SECRET=your_linear_client_secret

# =============================================================================
# x402 Micropayments (SaaS only)
# =============================================================================
X402_ENABLED=false
X402_WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS
X402_RPC_URL=https://mainnet.base.org
X402_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# =============================================================================
# BugWatch Self-Monitoring (optional — dogfooding)
# =============================================================================
BUGWATCH_API_KEY=your_bugwatch_api_key
BUGWATCH_ENABLED=false
