# =============================================================================
# Bugwatch — example environment file
# =============================================================================
# Copy to `.env` and fill in values. Vars below the "Cloud only" divider are
# only needed when running the SaaS build (`cargo build --features saas` with
# BUGWATCH_MODE=saas). Self-hosters can leave them empty.

# ---------- Required (self-host & cloud) ----------

# Server
SERVER_ADDR=0.0.0.0:3000
# POSTGRES_PASSWORD must match the password in DATABASE_URL and in docker-compose.dev.yml
POSTGRES_PASSWORD=bugwatch_dev
DATABASE_URL=postgres://bugwatch:bugwatch_dev@localhost:5432/bugwatch
ENVIRONMENT=development
RUST_LOG=debug

# Deployment mode: `self-hosted` (default) or `saas`.
# `self-hosted` disables billing and grants every org the Team tier.
# `saas` requires building the server with `--features saas`.
BUGWATCH_MODE=self-hosted

# Auth
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000

# ---------- Hosted MCP server (bugwatch.dev/mcp) ----------

# Single shared Bugwatch agent key the hosted MCP acts as. Every caller of /mcp
# operates as this key, so scope it appropriately (bw_agent_*). Required for the
# bugwatch-mcp container to start.
BUGWATCH_AGENT_KEY=
# Shared bearer secret that gates the public /mcp endpoint. Callers must send
# `Authorization: Bearer <this>`. Strongly recommended — if empty, /mcp is open.
MCP_AUTH_TOKEN=

# ---------- Optional integrations (both modes) ----------

# AI Provider (for AI Fix feature)
ANTHROPIC_API_KEY=

# GitHub Integration (for PR creation)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Cloud only (BUGWATCH_MODE=saas, --features saas) ----------

# Email (AWS SES — only compiled with `saas` feature)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
FROM_EMAIL=alerts@bugwatch.dev

# Stripe (billing — only compiled with `saas` feature)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_ANNUAL=
STRIPE_PRICE_ID_TEAM_MONTHLY=
STRIPE_PRICE_ID_TEAM_ANNUAL=
