# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Build arguments baked into frontend at build time.
# Kept as ARG (not ENV) so values are not persisted in image layer metadata —
# they are written to .env.production below for Next.js to inline at build time.
ARG NEXT_PUBLIC_API_URL=http://localhost:3000
ARG NEXT_PUBLIC_BUGWATCH_API_KEY

# Copy web app manifests together — both must be in sync for npm ci.
# Separate COPY instructions preserve layer caching: npm ci only re-runs
# when package.json or package-lock.json actually changes.
COPY apps/web/package.json apps/web/package-lock.json ./

# Install exact versions from the lockfile; fails loudly if package.json
# and package-lock.json are out of sync, catching version drift early.
RUN npm ci

# Overlay local SDK builds (includes fixes not yet published to npm)
COPY packages/sdk/nextjs/dist ./node_modules/@bugwatch/nextjs/dist
COPY packages/sdk/nextjs/package.json ./node_modules/@bugwatch/nextjs/package.json

# Copy source code and config files
COPY apps/web/src ./src
COPY apps/web/public ./public
COPY apps/web/tsconfig.json ./
COPY apps/web/tailwind.config.ts ./
COPY apps/web/postcss.config.mjs ./
COPY apps/web/next.config.ts ./
COPY apps/web/next-env.d.ts ./
COPY apps/web/source.config.ts ./
COPY apps/web/.source ./.source
COPY tsconfig.base.json /tsconfig.base.json

# Create .env.production with build args so Next.js picks them up
RUN echo "NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}" > .env.production && \
    if [ -n "$NEXT_PUBLIC_BUGWATCH_API_KEY" ]; then echo "NEXT_PUBLIC_BUGWATCH_API_KEY=${NEXT_PUBLIC_BUGWATCH_API_KEY}" >> .env.production; fi

# Build the application
RUN npm run build

# Production stage
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Install wget for health checks and create non-root user
RUN apk add --no-cache wget && \
    addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy built assets from standalone output
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

USER nextjs

EXPOSE 3001

ENV PORT=3001
ENV HOSTNAME="0.0.0.0"

# Wire /api/health into the container lifecycle so orchestrators (Docker, ECS, k8s)
# can detect unhealthy containers and restart them automatically.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -qO- http://localhost:3001/api/health || exit 1

CMD ["node", "server.js"]
