# Development Dockerfile - runs Next.js dev server with hot reloading
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./
COPY apps/web/package.json ./apps/web/
COPY packages/ ./packages/

# Install dependencies
RUN npm ci

# Copy source code
COPY apps/web ./apps/web
COPY tsconfig.base.json ./

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3001
ENV HOSTNAME="0.0.0.0"

EXPOSE 3001

# Run dev server (supports hot reloading)
CMD ["npm", "run", "dev", "--workspace=@bugwatch/web"]
