# Caddy with the Cloudflare DNS plugin baked in.
# Lets dev.bugwatch.dev / api-dev.bugwatch.dev get real Let's Encrypt certs
# via the DNS-01 challenge, which avoids needing inbound HTTP-01 reachability.
FROM caddy:2-builder-alpine AS builder
RUN xcaddy build \
    --with github.com/caddy-dns/cloudflare

FROM caddy:2-alpine
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
