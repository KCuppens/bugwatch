# =============================================================================
# Docker Compose example env — copy to docker/.env and fill in real values.
# =============================================================================
# docker/.env is gitignored; this example is safe to commit. All Stripe /
# billing vars are only required when running the cloud build (cargo feature
# `saas` + BUGWATCH_MODE=saas). Self-hosters can leave them empty.

POSTGRES_USER=bugwatch
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=bugwatch
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
PASSWORD_RESET_SECRET=your-password-reset-secret-different-from-jwt
OAUTH_STATE_SECRET=your-oauth-state-secret-different-from-jwt
BUGWATCH_ENCRYPTION_KEY=your-32-byte-hex-encoded-encryption-key
APP_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com

# Deployment mode: `self-hosted` (default) or `saas`.
# `self-hosted` disables billing and grants every org the Team tier.
BUGWATCH_MODE=self-hosted

# ---------- Cloud only (BUGWATCH_MODE=saas, build with --features saas) ----------

# Stripe API Keys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Price IDs
STRIPE_PRICE_ID_PRO_MONTHLY=price_xxx
STRIPE_PRICE_ID_PRO_ANNUAL=price_xxx
STRIPE_PRICE_ID_TEAM_MONTHLY=price_xxx
STRIPE_PRICE_ID_TEAM_ANNUAL=price_xxx

# Self-Monitoring (Bugwatch tracking its own errors)
# Must be set at build time — requires: docker compose build --no-cache web
NEXT_PUBLIC_BUGWATCH_API_KEY=bw_live_xxx
