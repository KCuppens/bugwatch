{$DOMAIN:localhost} {
    # API routes -> server
    handle /api/* {
        reverse_proxy bugwatch-server-green:3000
    }

    # Health check
    handle /health {
        reverse_proxy bugwatch-server-green:3000
    }

    # Agent install scripts
    handle /install.sh {
        reverse_proxy bugwatch-server-green:3000
    }
    handle /agent/* {
        reverse_proxy bugwatch-server-green:3000
    }

    # Everything else -> web
    handle {
        reverse_proxy bugwatch-web-green:3001
    }
}
