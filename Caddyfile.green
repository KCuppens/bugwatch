{$DOMAIN:localhost} {
    # API routes -> server
    handle /api/* {
        reverse_proxy bugwatch-server-green:3000
    }

    # Health check
    handle /health {
        reverse_proxy bugwatch-server-green:3000
    }

    # Agent install scripts
    handle /install.sh {
        reverse_proxy bugwatch-server-green:3000
    }
    handle /agent/* {
        reverse_proxy bugwatch-server-green:3000
    }

    # Everything else -> web
    handle {
        reverse_proxy bugwatch-web-green:3001
    }
}

# Backward-compatible API host: existing SDK clients were configured against
# https://api.bugwatch.dev before the single-origin cutover. Keep it serving the
# API directly so already-deployed integrations don't break.
api.bugwatch.dev {
    reverse_proxy bugwatch-server-green:3000
}
